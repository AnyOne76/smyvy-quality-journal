[Unit]
Description=GitHub Actions self-hosted runner (smyvy-quality-journal)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/actions-runner-smyvy
ExecStart=%h/actions-runner-smyvy/run.sh
Restart=always
RestartSec=15
Environment=RUNNER_ALLOW_RUNASROOT=0

[Install]
WantedBy=default.target
