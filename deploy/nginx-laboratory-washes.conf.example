# /etc/nginx/sites-available/laboratory-washes.kolbasa.ru
# ln -s .../sites-available/laboratory-washes.kolbasa.ru sites-enabled/
# sudo nginx -t && sudo systemctl reload nginx
#
# DNS (обязательно): A-запись laboratory-washes.kolbasa.ru → 10.0.5.173
# (как у validation.kolbasa.ru / cv.kolbasa.ru). Без записи — NXDOMAIN в браузере.

server {
    listen 80;
    server_name laboratory-washes.kolbasa.ru;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name laboratory-washes.kolbasa.ru;

    ssl_certificate /opt/validations/ssl/kolbasa.ru.crt;
    ssl_certificate_key /opt/validations/ssl/kolbasa.ru.key;
    ssl_trusted_certificate /opt/validations/ssl/kolbasa.ru.ca_bundle;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    allow 10.0.0.0/16;
    deny all;

    client_max_body_size 20M;

    location / {
        proxy_pass http://10.0.5.173:8020;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }
}
