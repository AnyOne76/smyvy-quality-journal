# Пример для aidev: /etc/nginx/sites-available/laboratory-washes.kolbasa.ru
# proxy на контейнер (порт 8020 на 10.0.5.173). TLS — certbot или корпоративный сертификат.

server {
    listen 80;
    server_name laboratory-washes.kolbasa.ru;

    location / {
        proxy_pass http://10.0.5.173:8020;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }
}
